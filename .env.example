# Copy to .env.local for local development. In Vercel, set the same names under Project > Settings > Environment Variables.

# Supabase project (Project Settings > API). Locally, `supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server only. Never expose to the browser. Used by the scheduler and to store encrypted source credentials.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# 32 random bytes, base64. Encrypts Snowflake and S3 credentials at rest. Generate with: npm run gen:secrets
# Keep it safe: if it is lost, saved source credentials cannot be decrypted and must be re-entered.
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Shared secret for the cron route. Vercel Cron sends it automatically as a Bearer token. Any long random string.
CRON_SECRET=replace-with-long-random-string

# Public address of the app (used in links). Locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
