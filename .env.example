# Copy to .env.local for local development. In Vercel, set the same names under Project > Settings > Environment Variables.

# Supabase project (Project Settings > API Keys). Locally, `supabase status` prints these.
# The public key is the publishable key (sb_publishable_..., or the legacy anon key): it is sent to browsers.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# The secret key (sb_secret_..., or the legacy service_role key). Server only: never expose it to the browser.
# Used by the scheduler and to store encrypted source credentials.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# 32 random bytes, base64. Encrypts Snowflake and S3 credentials at rest. Generate with: npm run gen:secrets
# Keep it safe: if it is lost, saved source credentials cannot be decrypted and must be re-entered.
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Shared secret for the cron route. Vercel Cron sends it automatically as a Bearer token. Any long random string.
CRON_SECRET=replace-with-long-random-string

# Public address of the app (used in links). Locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Billing (optional). Leave these out and every workspace has all features. See DEPLOY.md > Billing.
# STRIPE_SECRET_KEY=        # Stripe > Developers > API keys > Secret key
# STRIPE_PRICE_ID=          # the MONTHLY recurring price of your Pro product (price_...)
# STRIPE_PRICE_ID_YEARLY=   # the YEARLY price of the same product (optional; set it lower than 12 x monthly)
# STRIPE_WEBHOOK_SECRET=    # Stripe > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
# NEXT_PUBLIC_SUPPORT_EMAIL= # shown on the refund policy page as the address to write to
