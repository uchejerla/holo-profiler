{
  "name": "holo-profiler-app",
  "version": "0.1.0",
  "private": true,
  "description": "Holo Profiler: hosted data quality profiling, rules, schedules and exception management",
  "scripts": {
    "hud": "node scripts/build-hud.mjs",
    "dev": "npm run hud && next dev",
    "build": "npm run hud && next build",
    "start": "next start",
    "typecheck": "npm run hud && tsc --noEmit",
    "test": "npm run hud && node --test tests/*.test.mjs",
    "test:db": "node --test tests/db/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "check:env": "node scripts/check-env.mjs",
    "plan:pro": "node scripts/set-plan.mjs pro",
    "plan:hobby": "node scripts/set-plan.mjs hobby"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "next": "^16.4.6",
    "papaparse": "5.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "snowflake-sdk": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^25.0.1",
    "pg": "^8.13.1",
    "supabase": "^3.1.0",
    "typescript": "^5.7.2"
  }
}
